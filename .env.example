# Prompts on the job — an installation's settings. Copy to .env and fill in.
# The Kik-OS switches below are the ones kik-os.cornae.com runs with
# (kikaron: deploy/kik-os-test-box.md).

# ── This installation ────────────────────────────────────────────────
HOST=prompts.example.org
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
TIME_ZONE=Europe/Amsterdam
# Derived from HOST by the compose file: ALLOWED_HOSTS, APPS_HOSTS, CSRF_TRUSTED_ORIGINS.

# The one hub, its name and its first administrator (created on first start).
HUB_SLUG=potj
HUB_NAME=Prompts on the job
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=change-me

# ── Database (the compose service `db`) ──────────────────────────────
POSTGRES_DB=potj
POSTGRES_USER=potj
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_HOST=redis
REDIS_PORT=6379

# ── Kik-OS: only the platform and Prompts ────────────────────────────
INSTANCE_ENV=potj
STYLE_BUNDLE=kik-os
REGISTERED_APPS=prompts
KITS=
BILLING=False
MATRIX_STREAM_ENABLED=False
TERMS_ACCEPTANCE=False
MAIL_ADDRESS_WELCOME=False
CONFIGURATION_USAGE=False
CONFIGURATION_MARKETING=False
DESK_ARTWORK=False

# ── Mail (console until an SMTP relay is set) ────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ── Language model (optional) ────────────────────────────────────────
# Prompts' assistant needs a provider; add one in the Configuration app's
# "Artificial intelligence" well, or set an OpenAI-compatible endpoint here.
LLM_BASE_URL=
LLM_API_KEY=
LLM_TEXT_MODEL=
