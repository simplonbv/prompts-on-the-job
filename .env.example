# Prompts on the job — an installation's settings. Copy to .env and fill in.
# Read by kik_os.project.settings (the KIK_* names) and the entrypoint.

# ── This installation ────────────────────────────────────────────────
HOST=prompts.example.org
# A long random string: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
KIK_SECRET_KEY=change-me-to-a-long-random-string
KIK_INSTALLATION_NAME=Prompts on the job
# The assistant's name as it stands mid-sentence ("in een gesprek met …").
# Unset: "de assistent" (in the reader's language). A proper name works too:
# KIK_ASSISTANT_NAME=Kiki
KIK_LANGUAGE=nl
KIK_TIME_ZONE=Europe/Amsterdam
# Derived from HOST by the entrypoint: KIK_HOSTS, KIK_CSRF_ORIGINS.
# Without TLS in front (a test on http://localhost:8080) set this to 0:
KIK_SECURE_COOKIES=1

# The hub (the municipality) and its first administrator, made on first start.
KIK_HUB_NAME=Gemeente Voorbeeld
KIK_HUB_SLUG=voorbeeld
KIK_ADMIN_EMAIL=admin@example.org
KIK_ADMIN_PASSWORD=change-me

# ── Database (the compose service `db`) ──────────────────────────────
KIK_DATABASE_NAME=potj
KIK_DATABASE_USER=potj
KIK_DATABASE_PASSWORD=change-me

# ── Language model: an OpenAI-compatible endpoint ────────────────────
# Prompts' assistant, Check and Test need one. Added on first start; change
# it later under /beheer/ (Language models).
KIK_LLM_KIND=openai
KIK_LLM_BASE_URL=
KIK_LLM_API_KEY=
KIK_LLM_MODEL=

# ── Mail (console until an SMTP relay is set) ────────────────────────
KIK_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# KIK_EMAIL_HOST=  KIK_EMAIL_PORT=587  KIK_EMAIL_USER=  KIK_EMAIL_PASSWORD=
# KIK_EMAIL_USE_TLS=1  KIK_EMAIL_FROM=prompts@example.org
